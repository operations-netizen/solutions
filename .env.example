# Copy to .env and fill in. .env is gitignored; this file is not, so it must never
# contain real values.

# Server-side only. Do NOT prefix with VITE_ — Vite inlines VITE_* variables into
# the browser bundle, which would publish your database credentials.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=hobu_solutions
API_PORT=4000

# Optional. Node resolves the Atlas SRV record through the system nameserver; if
# that refuses the query, the server retries via these resolvers.
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# Where the browser finds the API. Unset to run on localStorage instead.
VITE_API_URL=http://localhost:4000
